<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.willneve.zen-backup</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/will/.local/bin/zen-backup.sh</string>
    </array>
    
    <!-- Run daily at 9am -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <!-- Also run when loaded (e.g., on login) -->
    <key>RunAtLoad</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/Users/will/.zen-backups/launchd-stdout.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/will/.zen-backups/launchd-stderr.log</string>
</dict>
</plist>
